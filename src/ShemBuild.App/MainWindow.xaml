<Window
    x:Class="ShemBuild.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hx="using:HelixToolkit.WinUI.SharpDX"
    Title="ShemBuild">
    <Grid x:Name="RootLayout" RowDefinitions="Auto,*,Auto" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" Margin="16,12" ColumnSpacing="10">
            <Button x:Name="ResourcePackButton" Click="SelectResourcePack_Click" />
            <Button x:Name="OpenButton" Grid.Column="1" Click="OpenSchematic_Click" />
            <Button x:Name="FitButton" Grid.Column="2" Click="FitScene_Click" IsEnabled="False" />
            <TextBlock x:Name="ResourcePackText" Grid.Column="3" VerticalAlignment="Center" Opacity="0.72" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,320">
            <hx:Viewport3DX
                x:Name="SceneViewport"
                Grid.Column="0"
                BackgroundColor="#FF202329"
                CameraMode="Inspect"
                IsRotationEnabled="True"
                ShowCoordinateSystem="True"
                ShowFrameRate="True"
                ShowViewCube="True" />

            <Border Grid.Column="1" Padding="16" BorderThickness="1,0,0,0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="StructureHeaderText" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="StructureInfoText" TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock x:Name="MaterialsHeaderText" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock x:Name="MaterialCountText" Opacity="0.8" />
                        <ListView x:Name="MaterialList" MinHeight="180" MaxHeight="520" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ShortcutHelpText" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.65" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="16,9" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
